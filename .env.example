# Production URL — used for canonical links, Open Graph, sitemap and robots.
# Not needed on Vercel: VERCEL_PROJECT_PRODUCTION_URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form → Telegram bot.
# 1. Create a bot with @BotFather and copy its token.
# 2. Send any message to the bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
